<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable directory browsing for security
    Options -Indexes

    # Handle Authorization Headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect all requests to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Security: Block direct HTTP access to sensitive environment and configuration files
<FilesMatch "^\.|\.(env|log|git|md|json|lock|yml|yaml|sql|ini|conf)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
